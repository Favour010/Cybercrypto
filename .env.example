# Which data layer to run on: "demo" (default; sample data in each browser,
# simulated portal runs, no external services) or "supabase" (docs/database.md).
JOBSYNC_DATA_MODE=demo

# Hosts the portal connection test may contact (comma-separated, https only).
JOBSYNC_PORTAL_TEST_HOSTS=jobsync-portal-tracker.lovable.app

# ---------------------------------------------------------------------------
# JobSync environment. Copy to .env.local and fill in real values.
# Never commit real secrets. Every integration is optional: when a value is
# missing the UI shows "Not configured" rather than pretending to be connected.
# ---------------------------------------------------------------------------

# Supabase. URL + anon key enable sign-in (every page requires it).
# The service-role key is server-only, bypasses RLS, and is used from Phase 3.
# Setup guide: docs/database.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Automation safety. DRY_RUN is the default; LIVE additionally requires
# JOBSYNC_ALLOW_LIVE_SUBMISSIONS=true and authorised portal access.
JOBSYNC_EXECUTION_MODE=dry_run
JOBSYNC_ALLOW_LIVE_SUBMISSIONS=false
JOBSYNC_MAX_CONCURRENCY=3

# Local development only: skip sign-in when Supabase is NOT configured.
# Ignored unless NODE_ENV=development (never applies to `next build`/`next start`).
JOBSYNC_DEV_AUTH_BYPASS=false

# Database integration tests (npm run test:db): a superuser URL to any
# PostgreSQL 14+ server. A throwaway database is created and dropped per run.
# JOBSYNC_TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres
